{
    "name": "file-transfer-client",
    "version": "0.0.0",
    "scripts": {
        "ng": "ng",
        "prestart": "npm run build:worker",
        "start": "ng serve",
        "prebuild": "npm run build:worker",
        "build": "ng build",
        "build:worker": "esbuild src/app/workers/service-worker.ts --bundle --outfile=public/service-worker.js --platform=browser --format=esm",
        "watch": "ng build --watch --configuration development",
        "test": "ng test"
    },
    "private": true,
    "packageManager": "npm@11.7.0",
    "dependencies": {
        "@angular/common": "^22.0.3",
        "@angular/compiler": "^22.0.3",
        "@angular/core": "^22.0.3",
        "@angular/forms": "^22.0.3",
        "@angular/platform-browser": "^22.0.3",
        "@angular/router": "^22.0.3",
        "@popperjs/core": "^2.11.8",
        "@shie1/bytes": "^1.1.1",
        "bootstrap": "^5.3.8",
        "bootstrap-icons": "^1.13.1",
        "idb": "^8.0.3",
        "rxjs": "~7.8.0",
        "tslib": "^2.3.0"
    },
    "devDependencies": {
        "@angular/build": "^22.0.4",
        "@angular/cli": "^22.0.4",
        "@angular/compiler-cli": "^22.0.3",
        "esbuild": "^0.28.1",
        "fake-indexeddb": "^6.2.5",
        "jsdom": "^28.0.0",
        "prettier": "^3.8.1",
        "typescript": "~6.0.3",
        "vitest": "^4.0.8"
    }
}
